@model ADMIN.Repository.Models.Ban

@{
    ViewData["Title"] = "Tạo Bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Tạo Bàn Mới</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded p-4 shadow-sm">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-4">
                        <label asp-for="TenBan" class="form-label">Tên Bàn</label>
                        <input asp-for="TenBan" class="form-control" placeholder="Nhập tên bàn" />
                        <span asp-validation-for="TenBan" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="TrangThai" value="false" />

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Tạo Bàn" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
