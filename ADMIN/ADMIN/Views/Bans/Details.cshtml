@model ADMIN.Repository.Models.Ban

@{
    ViewData["Title"] = "Chi Tiết Bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Chi Tiết Bàn</h2>
    <div class="border rounded p-4 shadow-sm">
        <hr />
        <dl class="row">
            <dt class="col-sm-3 font-weight-bold">
                Tên Bàn
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.TenBan)
            </dd>
            <dt class="col-sm-3 font-weight-bold">
                Sử Dụng
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.TrangThai)
            </dd>
        </dl>
    </div>
    <div class="d-flex justify-content-between">
        <a asp-action="Edit" asp-route-id="@Model?.BanId" class="btn btn-warning">Chỉnh Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
    </div>
</div>
