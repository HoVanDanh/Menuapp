@model ADMIN.Repository.Models.HoaDon

@{
    ViewData["Title"] = "Chỉnh Sửa Hóa Đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Chỉnh Sửa Hóa Đơn</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded p-4 shadow-sm">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="HoaDonId" />

                    <div class="form-group mb-4">
                        <label asp-for="KhachHangId" class="form-label">Khách Hàng</label>
                        <select asp-for="KhachHangId" class="form-control" asp-items="ViewBag.KhachHangId"></select>
                        <span asp-validation-for="KhachHangId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="BanId" class="form-label">Bàn</label>
                        <select asp-for="BanId" class="form-control" asp-items="ViewBag.BanId"></select>
                        <span asp-validation-for="BanId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="NgayTao" class="form-label">Ngày Tạo</label>
                        <input asp-for="NgayTao" class="form-control" />
                        <span asp-validation-for="NgayTao" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="TongTien" class="form-label">Tổng Tiền</label>
                        <input asp-for="TongTien" class="form-control" />
                        <span asp-validation-for="TongTien" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Lưu" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
