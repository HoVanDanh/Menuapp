@*@{
    ViewData["Title"] = "Thống Kê Doanh Thu";
    var danhSachHoaDon = ViewBag.DanhSachHoaDon as IEnumerable<ADMIN.Repository.Models.HoaDon>;
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Thống Kê Doanh Thu</h1>

    <div class="form-group mb-4">
        <div class="d-flex">
            <!-- Chọn Ngày -->
            <div class="form-group me-2">
                <label for="datePicker" class="form-label">Chọn Ngày Thống Kê</label>
                <input type="date" id="datePicker" name="datePicker" class="form-control">
            </div>

            <!-- Chọn Tháng và Năm -->
            <div class="form-group me-2">
                <label for="monthPicker" class="form-label">Chọn Tháng và Năm</label>
                <input type="month" id="monthPicker" name="monthPicker" class="form-control">
            </div>

            <div class="form-group">
                <label for="yearPicker" class="form-label">Chọn Năm</label>
                <select id="yearPicker" name="yearPicker" class="form-select">
                    <option value="">--Chọn Năm--</option>
                    @for (int year = 2023; year <= 2030; year++)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
        </div>

        <button type="button" class="btn btn-primary" id="filterButton">
            Lọc
        </button>
    </div>

    <!-- Label thông báo -->
    <div id="alertContainer" class="mt-3 text-center border rounded p-3 bg-light" style="display: none;">
        <label id="alertLabel" class="text-danger h5">Tổng Doanh Thu: 0 vnđ</label>
    </div>

    <table class="table table-bordered mt-3" id="hoaDonTable">
        <thead>
            <tr>
                <th class="text-center">Mã Đơn</th>
                <th class="text-center">Số Tiền</th>
                <th class="text-center">Ngày Tạo Hóa Đơn</th>
            </tr>
        </thead>
        <tbody id="hoaDonBody">
            @if (danhSachHoaDon != null && danhSachHoaDon.Any())
            {
                foreach (var hoaDon in danhSachHoaDon)
                {
                    <tr class="hoaDonRow" data-ngay-tao="@hoaDon.NgayTao.ToString("yyyy-MM-dd")">
                        <td class="text-center">@hoaDon.HoaDonId</td>
                        <td class="text-center tongTien">@hoaDon.TongTien</td>
                        <td class="text-center">@hoaDon.NgayTao.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center" colspan="3">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('datePicker').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('monthPicker').value = '';
            document.getElementById('yearPicker').value = '';
        }
    });

    document.getElementById('monthPicker').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('datePicker').value = '';
            document.getElementById('yearPicker').value = '';
        }
    });

    document.getElementById('yearPicker').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('datePicker').value = '';
            document.getElementById('monthPicker').value = '';
        }
    });

    document.getElementById('filterButton').addEventListener('click', function () {
        var datePickerValue = document.getElementById('datePicker').value;
        var monthPickerValue = document.getElementById('monthPicker').value;
        var yearPickerValue = document.getElementById('yearPicker').value;
        var rows = document.querySelectorAll('.hoaDonRow');
        var total = 0;
        var hasFiltered = false;

        rows.forEach(function (row) {
            var ngayTao = row.getAttribute('data-ngay-tao');
            var includeRow = false;

            if (datePickerValue) {
                includeRow = ngayTao === datePickerValue;
                hasFiltered = true;
            } else if (monthPickerValue) {
                includeRow = ngayTao.startsWith(monthPickerValue);
                hasFiltered = true;
            } else if (yearPickerValue) {
                includeRow = ngayTao.startsWith(yearPickerValue);
                hasFiltered = true;
            }

            if (includeRow) {
                row.style.display = '';
                total += parseFloat(row.querySelector('.tongTien').textContent);
            } else {
                row.style.display = 'none';
            }
        });

        if (hasFiltered) {
            document.getElementById('alertLabel').textContent = 'Tổng Doanh Thu: ' + total.toLocaleString('vi-VN') + ' vnđ';
            document.getElementById('alertContainer').style.display = 'block';
        }
    });
</script>
*@
@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="container mt-4">
    <h3 class="text-center mb-4">Doanh Thu Trong Ngày</h3>

    <div class="row">
        <!-- Card Số lượng Đơn Hàng -->
        <div class="col-md-6 mb-4">
            <div class="card card-custom text-center shadow">
                <div class="card-body">
                    <div class="icon-circle bg-primary text-white mb-3 mx-auto">
                        <i class="fas fa-receipt fa-2x"></i>
                    </div>
                    <h5 class="card-title">Số Lượng Đơn Hàng Trong Ngày</h5>
                    <p class="card-text display-4 text-primary">@ViewBag.SoLuongDonHang</p>
                </div>
            </div>
        </div>

        <!-- Card Tổng Doanh Thu -->
        <div class="col-md-6 mb-4">
            <div class="card card-custom text-center shadow">
                <div class="card-body">
                    <div class="icon-circle bg-success text-white mb-3 mx-auto">
                        <i class="fas fa-dollar-sign fa-2x"></i>
                    </div>
                    <h5 class="card-title">Tổng Doanh Thu Trong Ngày</h5>
                    <p class="card-text display-4 text-success">@ViewBag.TongDoanhThu.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</p>
                </div>
            </div>
        </div>
    </div>
</div>
