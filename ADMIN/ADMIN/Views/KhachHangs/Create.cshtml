@model ADMIN.Repository.Models.KhachHang

@{
    ViewData["Title"] = "Tạo Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Tạo Khách Hàng Mới</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded p-4 shadow-sm">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-4">
                        <label asp-for="TenKhachHang" class="form-label">Tên Khách Hàng</label>
                        <input asp-for="TenKhachHang" class="form-control" placeholder="Nhập tên khách hàng" />
                        <span asp-validation-for="TenKhachHang" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="SoDienThoai" class="form-label">Số Điện Thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DiaChi" class="form-label">Địa Chỉ</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Tạo Khách Hàng" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector("form").addEventListener("submit", function (event) {

            if (!isValid) {
                event.preventDefault();
            }
        });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial");
}
