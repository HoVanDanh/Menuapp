@model ADMIN.Repository.Models.KhachHang

@{
    ViewData["Title"] = "Chỉnh Sửa Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Chỉnh Sửa Khách Hàng</h2>
    <div class="border rounded p-4 shadow-sm">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="KhachHangId" />

            <div class="form-group mb-3">
                <label asp-for="TenKhachHang" class="control-label">Tên Khách Hàng</label>
                <input asp-for="TenKhachHang" class="form-control" placeholder="Nhập tên khách hàng" />
                <span asp-validation-for="TenKhachHang" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SoDienThoai" class="control-label">Số Điện Thoại</label>
                <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DiaChi" class="control-label">Địa Chỉ</label>
                <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-success" />
            </div>
        </form>
    </div>
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
