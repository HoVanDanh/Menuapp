@model ADMIN.Repository.Models.MonAn

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var groupedNguyenLieu = Model.NguyenLieuMonAns
        .GroupBy(nl => nl.NguyenLieu.NguyenLieuId)
        .Select(g => new
        {
            NguyenLieu = g.First().NguyenLieu,
            SoLuongTong = g.Sum(nl => nl.SoLuong)
        })
        .ToList();
}

@* <h2 class="text-center mb-4">Chi Tiết Món Ăn</h2> *@

<div class="container">
    <div class="card mb-4">
        <div class="card-header text-center font-weight-bold">Thông Tin Món Ăn</div>
        <div class="card-body">
            <div class="row">
                <!--Thông tin-->
                <div class="col-md-8">
                    <div class="form-group d-flex align-items-center mb-3">
                        <label class="font-weight-bold mb-0" style="min-width: 150px;">Tên Món Ăn:</label>
                        <p class="form-control-plaintext mb-0">@Html.DisplayFor(model => model.TenMon)</p>
                    </div>
                    <div class="form-group d-flex align-items-center mb-3">
                        <label class="font-weight-bold mb-0" style="min-width: 150px;">Loại Món Ăn:</label>
                        <p class="form-control-plaintext mb-0">@Html.DisplayFor(model => model.LoaiMonAn.TenLoai)</p>
                    </div>
                    <div class="form-group d-flex align-items-center mb-3">
                        <label class="font-weight-bold mb-0" style="min-width: 150px;">Giá:</label>
                        <p class="form-control-plaintext mb-0">@Html.DisplayFor(model => model.Gia) VNĐ</p>
                    </div>
                    <div class="form-group d-flex align-items-center">
                        <label class="font-weight-bold mb-0" style="min-width: 150px;">Trạng Thái:</label>
                        <p class="form-control-plaintext mb-0">
                            @if (Model.TrangThaiMonAn.HasValue && Model.TrangThaiMonAn.Value)
                            {
                                <span class="badge bg-success">Còn Bán</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ngưng Bán</span>
                            }
                        </p>
                    </div>
                </div>

                <!--Hình ảnh-->
                <div class="col-md-4 text-center">
                    <div class="form-group">
                        <label class="font-weight-bold">Hình Ảnh:</label>
                        @if (!string.IsNullOrEmpty(Model.Img))
                        {
                            <div class="mt-3">
                                <img src="@Url.Content(Model.Img)" alt="Current Image" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mt-3">
                                Không có hình ảnh.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    <div class="card mb-4">
        <div class="card-header">Nguyên Liệu Món Ăn</div>
        <div class="card-body">
            <div class="row">
                <ul class="list-group">
                    @foreach (var nguyenLieu in groupedNguyenLieu)
                    {
                        <li class="list-group-item">
                            @nguyenLieu.NguyenLieu.TenNguyenLieu - Số lượng: @nguyenLieu.SoLuongTong - @nguyenLieu.NguyenLieu.DonVi
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>



    <div class="d-flex justify-content-between">
        <a asp-action="Edit" asp-route-id="@Model.MonAnId" class="btn btn-warning">Chỉnh Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay Lại Danh Sách</a>
    </div>
