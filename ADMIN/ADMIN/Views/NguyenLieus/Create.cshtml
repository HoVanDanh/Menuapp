@model ADMIN.Repository.Models.NguyenLieu

@{
    ViewData["Title"] = "Tạo Nguyên Liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Tạo Nguyên Liệu Mới</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded p-4 shadow-sm">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-4">
                        <label asp-for="TenNguyenLieu" class="form-label">Tên Nguyên Liệu</label>
                        <input asp-for="TenNguyenLieu" class="form-control" placeholder="Nhập tên nguyên liệu" />
                        <span asp-validation-for="TenNguyenLieu" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="SoLuong" class="form-label">Số Lượng</label>
                        <input asp-for="SoLuong" class="form-control" placeholder="Nhập số lượng" />
                        <span asp-validation-for="SoLuong" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DonVi" class="form-label">Đơn Vị</label>
                        <input asp-for="DonVi" class="form-control" placeholder="Nhập đơn vị" />
                        <span asp-validation-for="DonVi" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Tạo Nguyên Liệu" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
