@model IEnumerable<ADMIN.Repository.Models.NguyenLieu>

@{
    ViewData["Title"] = "Danh Sách Nguyên Liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
        <h2 class="text-center">Danh Sách Nguyên Liệu</h2>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" asp-action="Index" class="mb-3">
            <div class="input-group">
                <input type="text" id="searchString" name="searchString" class="form-control" placeholder="Tìm kiếm nguyên liệu..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <a class="btn btn-primary" asp-action="Create">Tạo Mới</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Tên Nguyên Liệu</th>
                    <th>Số Lượng</th>
                    <th>Đơn Vị</th>
                    <th class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TenNguyenLieu)</td>
                        <td>@Html.DisplayFor(modelItem => item.SoLuong)</td>
                        <td>@Html.DisplayFor(modelItem => item.DonVi)</td>
                        <td class="text-center">
                            <div class="text-center align-middle">
                                <a asp-action="Edit" asp-route-id="@item.NguyenLieuId" class="btn btn-warning btn-sm" title="Sửa">Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.NguyenLieuId" class="btn btn-info btn-sm" title="Chi Tiết">Chi Tiết
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewData["CurrentFilter"]">Previous</a>
                </li>
            }

            @for (var i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@ViewData["CurrentFilter"]">@i</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewData["CurrentFilter"]">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>
