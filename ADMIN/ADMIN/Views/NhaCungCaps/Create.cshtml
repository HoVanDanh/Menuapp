@model ADMIN.Repository.Models.NhaCungCap

@{
    ViewData["Title"] = "Tạo Nhà Cung Cấp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Tạo Nhà Cung Cấp Mới</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded p-4 shadow-sm">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-4">
                        <label asp-for="TenNhaCungCap" class="form-label">Tên Nhà Cung Cấp</label>
                        <input asp-for="TenNhaCungCap" class="form-control" placeholder="Nhập tên nhà cung cấp" />
                        <span asp-validation-for="TenNhaCungCap" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DiaChi" class="form-label">Địa Chỉ</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="SoDienThoai" class="form-label">Số Điện Thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" type ="number" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Tạo Mới" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
