@model IEnumerable<ADMIN.Repository.Models.NhaCungCap>

@{
    ViewData["Title"] = "Danh Sách Nhà Cung Cấp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center">Danh Sách Nhà Cung Cấp</h2>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" asp-action="Index" class="mb-3">
            <div class="input-group">
                <input type="text" id="searchString" name="searchString" class="form-control" placeholder="Tìm kiếm nhà cung cấp..." value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <a class="btn btn-primary" asp-action="Create">Tạo Mới</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Tên Nhà Cung Cấp</th>
                    <th>Địa Chỉ</th>
                    <th>Số Điện Thoại</th>
                    <th class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TenNhaCungCap)</td>
                        <td>@Html.DisplayFor(modelItem => item.DiaChi)</td>
                        <td>@Html.DisplayFor(modelItem => item.SoDienThoai)</td>
                        <td class="text-center">
                            <div class="text-center align-middle">
                                <a asp-action="Edit" asp-route-id="@item.NhaCungCapId" class="btn btn-warning btn-sm" title="Sửa">Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.NhaCungCapId" class="btn btn-info btn-sm" title="Chi Tiết">Chi Tiết
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.NhaCungCapId" class="btn btn-danger btn-sm" title="Xóa">Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
