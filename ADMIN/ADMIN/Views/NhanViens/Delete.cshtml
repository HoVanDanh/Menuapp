@model ADMIN.Repository.Models.NhanVien

@{
    ViewData["Title"] = "Xóa Nhân Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Xóa Nhân Viên</h2>
    <hr />
    <div class="border rounded p-4 shadow-sm">
        <h3 class="text-danger">Bạn có chắc chắn muốn xóa nhân viên này?</h3>
        <dl class="row">
            <dt class="col-sm-3">Tên Nhân Viên</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TenNhanVien)</dd>

            <dt class="col-sm-3">Số Điện Thoại</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SoDienThoai)</dd>

            <dt class="col-sm-3">Địa Chỉ</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DiaChi)</dd>

            <dt class="col-sm-3">Loại Nhân Viên</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LoaiNhanVien.LoaiNhanVienId)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="NhanVienId" />
            <div class="d-flex justify-content-between">
                <input type="submit" value="Xóa" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Trở Về Danh Sách</a>
            </div>
        </form>
    </div>
</div>
